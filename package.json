{
	"name": "portfolio-vue",
	"type": "module",
	"private": true,
	"volta": {
		"node": "24"
	},
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"docker:start": "docker compose up -d",
		"docker:stop": "docker compose down",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --ignore-unknown --list-different --write .",
		"format:check": "prettier . --ignore-unknown --list-different",
		"prepare": "husky",
		"postinstall": "nuxt prepare"
	},
	"lint-staged": {
		"*.{js,ts,mts,cts,mjs,cjs,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,scss,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "5.3.0",
		"@iconify/vue": "5.0.1",
		"@lucide/vue": "1.39.0",
		"@vueuse/core": "14.4.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"nuxt": "4.5.2",
		"reka-ui": "2.10.4",
		"shadcn-nuxt": "2.8.2",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"vue": "3.5.42",
		"vue-router": "5.3.1"
	},
	"devDependencies": {
		"@nuxt/eslint": "1.17.0",
		"@nuxtjs/color-mode": "4.0.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.4.1",
		"eslint": "10.9.1",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"prettier": "3.9.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	}
}
